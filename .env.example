# Optional. Without a key Plumbline runs on its offline rule-based extractor.
ANTHROPIC_API_KEY=
# Model used for extraction (default: claude-opus-5-5)
PLUMBLINE_MODEL=claude-opus-5-5
# SQLite file location (default: ./data/plumbline.db)
PLUMBLINE_DB=./data/plumbline.db
# Seed a demo project on first run (set to 0 to disable)
PLUMBLINE_SEED=1
# Enables the tamper-simulation + reset buttons (never enable in production)
PLUMBLINE_DEMO=1
