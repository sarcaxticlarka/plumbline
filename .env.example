# ── AI engine ────────────────────────────────────────────────────────────────
# Optional. Visitors can also paste their own key in Settings (no env needed). Without any key the offline engine runs.
ANTHROPIC_API_KEY=
PLUMBLINE_MODEL=claude-opus-5-5
# Force the offline engine for everyone:  PLUMBLINE_PROVIDER=local
# Self-hosting a local model (Ollama) on a private address:  PLUMBLINE_ALLOW_PRIVATE_URLS=1

# ── Data ─────────────────────────────────────────────────────────────────────
PLUMBLINE_DB=./data/plumbline.db
PLUMBLINE_SEED=1

# ── Demo (NEVER enable in production) ────────────────────────────────────────
# One-click role logins, "Simulate tampering", "Rewrite whole chain", "Reset demo data".
PLUMBLINE_DEMO=1

# ── Email notices & delivery receipts (pick ONE; with neither, emails are recorded but NOT delivered) ──
# PLUMBLINE_SMTP_URL=smtp://user:pass@smtp.example.com:587
# RESEND_API_KEY=re_...
# PLUMBLINE_FROM="Plumbline <notices@yourdomain.com>"
# Resend delivery webhooks -> POST /api/webhooks/email?token=<secret>
# PLUMBLINE_WEBHOOK_SECRET=

# ── Chain anchoring ──────────────────────────────────────────────────────────
# RFC 3161 timestamp authority (default freetsa.org, fallback DigiCert)
# PLUMBLINE_TSA_URL=https://freetsa.org/tsr
# Enables GET /api/cron/anchor (Bearer secret) for a daily scheduled anchor of every project
# CRON_SECRET=
